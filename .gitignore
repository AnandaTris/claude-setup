# Allowlist repo: ignore everything, then re-include only hand-authored config.
# Last matching pattern wins, so order here matters.

# 1. Ignore all files, but still descend into directories.
*
!*/

# 2. Re-include the things worth versioning.
!.gitignore
!CLAUDE.md
!settings.json
!settings.local.json
!hooks/**
!statusline-command.sh
!projects/*/memory/**
!skill guide download for Claude.md

# 3. Re-exclude heavy or churny trees entirely so git never walks them.
/backups/
/cache/
/daemon/
/downloads/
/file-history/
/ide/
/jobs/
/paste-cache/
/plans/
/plugins/
/session-env/
/sessions/
/shell-snapshots/
/tasks/
/telemetry/

# skills/ is 393MB and reinstallable — see "skill guide download for Claude.md".
# Exclude its contents rather than the directory itself, so the one skill with no
# upstream (gemini-media, 28K) can still be re-included below.
/skills/*
!/skills/gemini-media/
!/skills/gemini-media/**

# Never track app-written state, macOS cruft, or secrets.
.DS_Store
.claude.json
*.log
*.lock
*-cache.json
setting.json
