{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --mirror*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.zshrc)",
      "Read(//**/.zshenv)",
      "Read(//**/.zprofile)",
      "Read(//**/.zlogin)",
      "Read(//**/.bashrc)",
      "Read(//**/.bash_profile)",
      "Read(//**/.bash_login)",
      "Read(//**/.profile)",
      "Grep(//**/.zshrc)",
      "Grep(//**/.zshenv)",
      "Grep(//**/.zprofile)",
      "Grep(//**/.bash_profile)",
      "Read(//Users/anandatriharismaroso/dev/8x_Internship/Keys)",
      "Read(//Users/anandatriharismaroso/dev/8x_Internship/Keys/**)",
      "Read(//Users/anandatriharismaroso/dev/8x_Internship/keys)",
      "Read(//Users/anandatriharismaroso/dev/8x_Internship/keys/**)",
      "Grep(//Users/anandatriharismaroso/dev/8x_Internship/Keys/**)",
      "Grep(//Users/anandatriharismaroso/dev/8x_Internship/keys/**)",
      "Glob(//Users/anandatriharismaroso/dev/8x_Internship/Keys/**)",
      "Glob(//Users/anandatriharismaroso/dev/8x_Internship/keys/**)",
      "Edit(//Users/anandatriharismaroso/dev/8x_Internship/Keys/**)",
      "Edit(//Users/anandatriharismaroso/dev/8x_Internship/keys/**)",
      "Write(//Users/anandatriharismaroso/dev/8x_Internship/Keys/**)",
      "Write(//Users/anandatriharismaroso/dev/8x_Internship/keys/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // \\\"\\\"\" | sed -E \"s/\\.env\\.(example|sample|template)//g\" | grep -qiE \"\\.env(rc)?([^A-Za-z0-9]|$)\" && printf \"%s\" \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"Blocked: this command references a .env file. Your settings deny access to .env contents (Read deny rules plus this hook), and that applies to Bash too. Ask the user to run it themselves, or use .env.example instead.\\\"}}\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-secret-reads.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // \\\"\\\"\" | grep -qiE \"git[[:space:]]+push.*(--force|--mirror|[[:space:]]-f([[:space:]]|$))\" && printf \"%s\" \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"Blocked: force push. You review force pushes yourself. Run it manually if you actually want it.\\\"}}\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/marcel-detector.sh",
            "timeout": 15,
            "statusMessage": "Marcel detector",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/sync/hooks/session-check.sh",
            "timeout": 15,
            "statusMessage": "Config sync check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/sync/hooks/config-drift.sh",
            "timeout": 15,
            "statusMessage": "Config drift check",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "posthog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "precomputeCompactionEnabled": true,
  "agentPushNotifEnabled": true
}
